<Window x:Class="UniversalConvert.App.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义转换" Height="460" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinHeight="360" MinWidth="420">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileText" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <TextBlock x:Name="FormatText" Grid.Row="1" Foreground="#666666" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,8">
            <TextBlock Text="预设：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PresetCombo" Width="220"
                      SelectionChanged="OnPresetChanged"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Padding="16,6" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="开始转换" Padding="16,6" FontWeight="SemiBold" Click="OnConvert"/>
        </StackPanel>
    </Grid>
</Window>

<Application x:Class="UniversalConvert.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#0078D4"/>
            <!-- 明暗主题自定义资源（ApplyAppTheme 时切换） -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#DDDDDD"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

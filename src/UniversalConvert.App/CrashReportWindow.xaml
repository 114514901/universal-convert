<Window x:Class="UniversalConvert.App.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.CrashReportTitle}" Height="560" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinHeight="360" MinWidth="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" FontWeight="SemiBold" Foreground="#DC3545"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,8">
            <TextBlock Text="{x:Static loc:Strings.CrashContinueWarning}" Foreground="#664D03"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.CrashReportTitle}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.LogLabel}" FontWeight="SemiBold" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ReportText" Grid.Column="0" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Margin="0,0,6,0"/>
            <TextBox x:Name="LogText" Grid.Column="1" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Margin="6,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static loc:Strings.CopyReport}" Padding="12,5" Click="OnCopyReport" Margin="0,0,6,0"/>
            <Button Content="{x:Static loc:Strings.CopyLog}" Padding="12,5" Click="OnCopyLog" Margin="0,0,6,0"/>
            <Button Content="{x:Static loc:Strings.OpenLogFolder}" Padding="12,5" Click="OnOpenFolder" Margin="0,0,6,0"/>
            <Button Content="{x:Static loc:Strings.Restart}" Padding="12,5" Click="OnRestart" Margin="0,0,6,0"/>
            <Button x:Name="ContinueButton" Content="{x:Static loc:Strings.Continue}" Padding="12,5" FontWeight="SemiBold"
                    Click="OnContinue" Margin="0,0,6,0"/>
            <Button Content="{x:Static loc:Strings.TerminateProcess}" Padding="12,5" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

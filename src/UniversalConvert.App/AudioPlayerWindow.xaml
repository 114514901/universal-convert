<Window x:Class="UniversalConvert.App.AudioPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.AudioPlayer}" Height="280" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closed="OnWindowClosed">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Slider x:Name="ProgressSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="0"
                IsMoveToPointEnabled="True" IsEnabled="False"
                ValueChanged="OnProgressValueChanged"/>

        <TextBlock x:Name="TimeText" Grid.Row="2" Margin="0,4,0,0" Foreground="#666666"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{x:Static loc:Strings.Volume}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider x:Name="VolumeSlider" Width="220" Minimum="0" Maximum="1" Value="1"
                    VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="PlayPauseButton" Content="{x:Static loc:Strings.Pause}" Padding="16,6"
                    IsEnabled="False" Click="OnPlayPause" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.Stop}" Padding="16,6" Click="OnStop" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.Close}" Padding="16,6" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

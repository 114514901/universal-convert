<Window x:Class="UniversalConvert.App.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalConvert" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False"
        Topmost="True" MaxHeight="200" Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="20,16" Width="280">
        <TextBlock x:Name="MsgText" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13"/>
        <ProgressBar Height="6" IsIndeterminate="True"/>
    </StackPanel>
</Window>
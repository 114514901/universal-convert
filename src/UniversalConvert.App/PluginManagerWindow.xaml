<Window x:Class="UniversalConvert.App.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.PluginManagerTitle}" Height="460" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="320" MinWidth="480">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Plugins}" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <ListView x:Name="PluginList" Grid.Row="1" SelectionChanged="OnSelectionChanged"
                  ContextMenuOpening="OnContextMenuOpening">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static loc:Strings.Uninstall}" Click="OnUninstall"/>
                    <MenuItem Header="{x:Static loc:Strings.CheckUpdatePlugin}" Click="OnCheckUpdateSingle"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static loc:Strings.PluginNameColumn}" Width="200"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{x:Static loc:Strings.VersionColumn}" Width="70"
                                    DisplayMemberBinding="{Binding Version}"/>
                    <GridViewColumn Header="{x:Static loc:Strings.SourceColumn}" Width="60"
                                    DisplayMemberBinding="{Binding SourceText}"/>
                    <GridViewColumn Header="{x:Static loc:Strings.StatusColumn}" Width="240"
                                    DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="UpdateStatusText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="#666666"/>

        <Expander x:Name="ErrorExpander" Grid.Row="3" Margin="0,8,0,0"
                  Header="{x:Static loc:Strings.ErrorsLabel}" Visibility="Collapsed">
            <TextBox x:Name="ErrorBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="90"
                     FontFamily="Consolas" FontSize="12"/>
        </Expander>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CheckUpdatesButton" Content="{x:Static loc:Strings.CheckUpdates}"
                    Padding="14,6" Click="OnCheckUpdates" Margin="0,0,8,0"/>
            <Button x:Name="UninstallButton" Content="{x:Static loc:Strings.Uninstall}"
                    Padding="14,6" Click="OnUninstall" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.ExtensionsCenter}" Padding="14,6" Click="OnOpenExtensions" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.Close}" Padding="16,6" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UniversalConvert.App.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.ConvertingTitle}" Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinHeight="360" MinWidth="460"
        Loaded="OnLoaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="20"
                     IsIndeterminate="True" Minimum="0" Maximum="100"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="{x:Static loc:Strings.Preparing}" Margin="0,12,0,0"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <TextBlock x:Name="SuggestionText" Grid.Row="3" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="#B87333" Visibility="Collapsed"/>

        <Expander x:Name="DetailsExpander" Grid.Row="4" Margin="0,12,0,0"
                  Header="{x:Static loc:Strings.ErrorDetail}" Visibility="Collapsed">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="120"
                     FontFamily="Consolas" FontSize="12"/>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RetryButton" Content="{x:Static loc:Strings.Retry}" Padding="12,6"
                    Visibility="Collapsed" Click="OnRetry" Margin="0,0,8,0"/>
            <Button x:Name="CopyErrorButton" Content="{x:Static loc:Strings.CopyError}" Padding="12,6"
                    Visibility="Collapsed" Click="OnCopyError" Margin="0,0,8,0"/>
            <Button x:Name="OpenFolderButton" Content="{x:Static loc:Strings.OpenOutputFolder}" Padding="12,6"
                    Visibility="Collapsed" Click="OnOpenFolder" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" Padding="12,6" Click="OnCancel"/>
            <Button x:Name="PauseButton" Content="{x:Static loc:Strings.Pause}" Padding="12,6" Margin="8,0,0,0"
                    Click="OnPause"/>
            <Button x:Name="CloseButton" Content="{x:Static loc:Strings.Close}" Padding="12,6" Margin="8,0,0,0"
                    Click="OnClose" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UniversalConvert.App.BatchConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.BatchTitle}" Height="500" Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinHeight="380" MinWidth="520"
        Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListView x:Name="ItemList" Grid.Row="1" Margin="0,4,0,0"
                  MouseDoubleClick="OnItemDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static loc:Strings.FileColumn}" Width="380"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="{x:Static loc:Strings.StatusColumn}" Width="220"
                                    DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ProgressBar x:Name="OverallProgress" Grid.Row="2" Height="18" Margin="0,8,0,0"
                     Minimum="0" Maximum="100" Value="0"/>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <Expander x:Name="ErrorExpander" Grid.Row="4" Margin="0,8,0,0"
                  Header="{x:Static loc:Strings.ErrorsLabel}" Visibility="Collapsed">
            <TextBox x:Name="ErrorLogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="110"
                     FontFamily="Consolas" FontSize="12"/>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyErrorButton" Content="{x:Static loc:Strings.CopyError}" Padding="12,6"
                    Visibility="Collapsed" Click="OnCopyError" Margin="0,0,8,0"/>
            <Button x:Name="OpenFolderButton" Content="{x:Static loc:Strings.OpenOutputFolder}" Padding="12,6"
                    Visibility="Collapsed" Click="OnOpenFolder" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="{x:Static loc:Strings.Close}" Padding="12,6"
                    IsEnabled="False" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UniversalConvert.App.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.ReleaseNotesTitle}" Height="520" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="320" MinWidth="460">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="VersionText" Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

        <TextBox x:Name="BodyBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Close}" Padding="16,6" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

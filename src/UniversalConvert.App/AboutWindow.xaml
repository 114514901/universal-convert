<Window x:Class="UniversalConvert.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.About}" Height="720" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="560" MinWidth="420"
        Background="#F3F3F3">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="8" BorderBrush="#E5E5E5" BorderThickness="1" Padding="24">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="IconImage" Width="72" Height="72" Margin="0,0,0,12"/>

                <TextBlock Text="UniversalConvert" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

                <TextBlock x:Name="VersionText" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#666666"/>

                <TextBlock x:Name="DescText" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>

                <TextBlock x:Name="ThirdPartyText" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="380" Foreground="#999999" FontSize="12"/>

                <TextBlock x:Name="LicenseText" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="380" Foreground="#999999" FontSize="12"/>

                <TextBlock Text="{x:Static loc:Strings.SupportedFormatsTitle}" FontWeight="SemiBold"
                           Margin="0,14,0,0" HorizontalAlignment="Left" Width="380"/>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E5E5" BorderThickness="1"
                        Width="380" Margin="0,6,0,0">
                    <ListView x:Name="FormatsList" Height="170" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:Strings.FormatColumn}" Width="220"
                                                DisplayMemberBinding="{Binding Format}"/>
                                <GridViewColumn Header="{x:Static loc:Strings.SourceColumn}" Width="130"
                                                DisplayMemberBinding="{Binding Sources}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Button Content="{x:Static loc:Strings.OpenProject}" Margin="0,18,0,0" Padding="16,6"
                        Click="OnOpenProject" HorizontalAlignment="Center"/>
                <Button Content="{x:Static loc:Strings.Close}" Margin="0,8,0,0" Padding="16,6"
                        Click="OnClose" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

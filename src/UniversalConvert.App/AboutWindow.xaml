<Window x:Class="UniversalConvert.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.About}" Height="430" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24" HorizontalAlignment="Center">
        <Image x:Name="IconImage" Width="72" Height="72" Margin="0,0,0,12"/>

        <TextBlock Text="UniversalConvert" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock x:Name="VersionText" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#666666"/>

        <TextBlock x:Name="DescText" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>

        <TextBlock x:Name="ThirdPartyText" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="380" Foreground="#999999" FontSize="12"/>

        <Button Content="{x:Static loc:Strings.OpenProject}" Margin="0,18,0,0" Padding="16,6"
                Click="OnOpenProject" HorizontalAlignment="Center"/>
        <Button Content="{x:Static loc:Strings.Close}" Margin="0,8,0,0" Padding="16,6"
                Click="OnClose" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>

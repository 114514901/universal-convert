<Window x:Class="UniversalConvert.App.ExtensionUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="UniversalConvert" Height="380" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="240" MinWidth="440"
        Loaded="OnLoaded"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="ExtensionList" Grid.Row="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Column="1" Height="14" Margin="8,0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsIndeterminate}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PauseButton" Content="{x:Static loc:Strings.Pause}" Padding="14,4" Margin="0,0,8,0"
                    Click="OnPause"/>
            <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" Padding="14,4" Margin="0,0,8,0"
                    Click="OnCancel"/>
            <Button x:Name="CloseButton" Content="{x:Static loc:Strings.Close}" Width="90" IsEnabled="False" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

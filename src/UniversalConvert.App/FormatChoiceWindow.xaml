<Window x:Class="UniversalConvert.App.FormatChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.FormatChoiceTitle}" Height="300" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap"/>

        <ListBox x:Name="ChoiceList" Grid.Row="1" Margin="0,10,0,0" DisplayMemberPath="PluginName"/>

        <CheckBox x:Name="RememberCheck" Grid.Row="2" Content="{x:Static loc:Strings.DontAskAgain}"
                  Margin="0,10,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static loc:Strings.Cancel}" Padding="16,6" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.OK}" Padding="20,6" FontWeight="SemiBold" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UniversalConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="UniversalConvert" Height="560" Width="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Border x:Name="AdminBanner" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                    CornerRadius="4" Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.AdminWarning}" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="UpdateBanner" Background="#D1ECF1" BorderBrush="#17A2B8" BorderThickness="1"
                    CornerRadius="4" Padding="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="UpdateButton" Content="{x:Static loc:Strings.DownloadUpdate}"
                            Margin="8,0,0,0" Padding="10,2" Click="OnDownloadUpdate"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" FontSize="20" FontWeight="SemiBold"
                   Text="UniversalConvert" Margin="0,0,0,4"/>

        <Border Grid.Row="2" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6"
                Background="#F7F7F7" Padding="16">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.DropHint}" Foreground="#666666" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SelectedFileText" Text="{x:Static loc:Strings.NoFileSelected}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button Content="{x:Static loc:Strings.SelectFile}" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Padding="16,6" Click="OnSelectFile"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="3" Header="{x:Static loc:Strings.OutputFormats}" Margin="0,12,0,0">
            <ListBox x:Name="OutputList" SelectionMode="Single"
                     HorizontalContentAlignment="Stretch"
                     SelectionChanged="OnOutputSelectionChanged"/>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CustomizeButton" Content="{x:Static loc:Strings.Customize}" Height="36" FontSize="14"
                        Width="110" Margin="0,0,8,0" IsEnabled="False" Click="OnCustomize"/>
                <Button x:Name="ConvertButton" Content="{x:Static loc:Strings.Convert}" Height="36" FontSize="14"
                        Width="120" IsEnabled="False" Click="OnConvert"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

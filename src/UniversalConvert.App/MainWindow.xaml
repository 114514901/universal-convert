<Window x:Class="UniversalConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="UniversalConvert" Height="640" Width="720"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Loaded="OnLoaded">
    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部横幅 -->
        <StackPanel Grid.Row="0" Margin="16,16,16,0">
            <Border x:Name="DevBanner" Background="#F8D7DA" BorderBrush="#DC3545" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.DevVersionWarning}" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="AdminBanner" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.AdminWarning}" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="UpdateBanner" Background="#D1ECF1" BorderBrush="#17A2B8" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="ViewNotesButton" Content="{x:Static loc:Strings.ViewReleaseNotes}"
                                Margin="8,0,0,0" Padding="12,4" Click="OnViewReleaseNotes"/>
                        <Button x:Name="UpdateButton" Content="{x:Static loc:Strings.DownloadUpdate}"
                                Margin="8,0,0,0" Padding="12,4" Click="OnDownloadUpdate"/>
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,8,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="#555555" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 标题栏（自定义，含窗口控制按钮；无边框时用于拖动） -->
        <Grid Grid.Row="1" Margin="0,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="Transparent" Padding="16,12,0,8" MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="UniversalConvert" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{x:Static loc:Strings.Settings}" Padding="12,5" Click="OnOpenSettings" Margin="0,0,6,0"/>
                <Button Content="{x:Static loc:Strings.Plugins}" Padding="12,5" Click="OnOpenPlugins" Margin="0,0,6,0"/>
                <Button Content="{x:Static loc:Strings.About}" Padding="12,5" Click="OnOpenAbout" Margin="0,0,6,0"/>
                <Button Content="—" Padding="10,5" Click="OnMinimize" Margin="0,0,2,0"/>
                <Button Content="□" Padding="10,5" Click="OnMaximize" Margin="0,0,2,0"/>
                <Button Content="✕" Padding="10,5" Click="OnCloseWindow"/>
            </StackPanel>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 文件卡片 -->
            <Border x:Name="FileCard" Grid.Row="0" Background="White" CornerRadius="8" Padding="12"
                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="{x:Static loc:Strings.FilesLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{x:Static loc:Strings.AddFiles}" Padding="12,4" Click="OnAddFiles" Margin="0,0,6,0"/>
                            <Button Content="{x:Static loc:Strings.RemoveSelected}" Padding="12,4" Click="OnRemoveSelected" Margin="0,0,6,0"/>
                            <Button Content="{x:Static loc:Strings.ClearAll}" Padding="12,4" Click="OnClear"/>
                        </StackPanel>
                    </DockPanel>
                    <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Extended" Margin="0,10,0,0"
                              ToolTip="{x:Static loc:Strings.DropHint}"
                              MouseDoubleClick="OnFileDoubleClick" KeyDown="OnFileListKeyDown"
                              SelectionChanged="OnFileSelectionChanged">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static loc:Strings.Customize}" Click="OnCustomizeContext"/>
                                <MenuItem Header="{x:Static loc:Strings.Preview}" Click="OnPreviewContext"/>
                                <Separator/>
                                <MenuItem Header="{x:Static loc:Strings.RemoveSelected}" Click="OnRemoveContext"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:Strings.FileColumn}" Width="320"
                                                DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="{x:Static loc:Strings.ParamsColumn}" Width="140"
                                                DisplayMemberBinding="{Binding CustomizeLabel}"/>
                                <GridViewColumn Header="{x:Static loc:Strings.FormatColumn}" Width="90"
                                                DisplayMemberBinding="{Binding Format}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- 输出设置卡片 -->
            <Border x:Name="OutputCard" Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.OutputFormats}" FontWeight="SemiBold"/>
                    <ComboBox x:Name="OutputCombo" Margin="0,8,0,0" SelectionChanged="OnOutputSelectionChanged"/>
                    <TextBlock x:Name="NoCommonFormatText" Text="{x:Static loc:Strings.NoCommonFormat}"
                               Foreground="#B87333" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UntestedWarningText" Text="{x:Static loc:Strings.UntestedWarning}"
                               Foreground="#B87333" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{x:Static loc:Strings.OutputLocation}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="{x:Static loc:Strings.Browse}" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Click="OnBrowseOutput"/>
                        <TextBox x:Name="OutputDirText"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CustomizeButton" Content="{x:Static loc:Strings.Customize}" Height="40" FontSize="14"
                        Width="120" Margin="0,0,8,0" IsEnabled="False" Click="OnCustomize"/>
                <Button x:Name="ConvertButton" Content="{x:Static loc:Strings.Convert}" Height="40" FontSize="14"
                        Width="130" IsEnabled="False" Click="OnConvert"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

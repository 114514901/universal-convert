<Window x:Class="UniversalConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="UniversalConvert" Height="620" Width="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Border x:Name="DevBanner" Background="#F8D7DA" BorderBrush="#DC3545" BorderThickness="1"
                    CornerRadius="4" Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.DevVersionWarning}" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="AdminBanner" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                    CornerRadius="4" Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.AdminWarning}" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="UpdateBanner" Background="#D1ECF1" BorderBrush="#17A2B8" BorderThickness="1"
                    CornerRadius="4" Padding="8" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="ViewNotesButton" Content="{x:Static loc:Strings.ViewReleaseNotes}"
                                Margin="8,0,0,0" Padding="10,2" Click="OnViewReleaseNotes"/>
                        <Button x:Name="UpdateButton" Content="{x:Static loc:Strings.DownloadUpdate}"
                                Margin="8,0,0,0" Padding="10,2" Click="OnDownloadUpdate"/>
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,6,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="#555555" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button Content="{x:Static loc:Strings.Settings}" DockPanel.Dock="Right"
                    Padding="10,3" Click="OnOpenSettings"/>
            <Button Content="{x:Static loc:Strings.Plugins}" DockPanel.Dock="Right"
                    Padding="10,3" Margin="0,0,6,0" Click="OnOpenPlugins"/>
            <Button Content="{x:Static loc:Strings.About}" DockPanel.Dock="Right"
                    Padding="10,3" Margin="0,0,6,0" Click="OnOpenAbout"/>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="UniversalConvert" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="{x:Static loc:Strings.FilesLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{x:Static loc:Strings.AddFiles}" Padding="10,3" Click="OnAddFiles" Margin="0,0,6,0"/>
                    <Button Content="{x:Static loc:Strings.RemoveSelected}" Padding="10,3" Click="OnRemoveSelected" Margin="0,0,6,0"/>
                    <Button Content="{x:Static loc:Strings.ClearAll}" Padding="10,3" Click="OnClear"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="FileList" Grid.Row="1" SelectionMode="Extended" Margin="0,6,0,0"
                     ToolTip="{x:Static loc:Strings.DropHint}"
                     MouseDoubleClick="OnFileDoubleClick"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{x:Static loc:Strings.OutputFormats}" FontWeight="SemiBold"/>
            <ComboBox x:Name="OutputCombo" Margin="0,4,0,0" SelectionChanged="OnOutputSelectionChanged"/>
            <TextBlock x:Name="NoCommonFormatText" Text="{x:Static loc:Strings.NoCommonFormat}"
                       Foreground="#B87333" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CustomizeButton" Content="{x:Static loc:Strings.Customize}" Height="36" FontSize="14"
                        Width="110" Margin="0,0,8,0" IsEnabled="False" Click="OnCustomize"/>
                <Button x:Name="ConvertButton" Content="{x:Static loc:Strings.Convert}" Height="36" FontSize="14"
                        Width="120" IsEnabled="False" Click="OnConvert"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

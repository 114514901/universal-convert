<Window x:Class="UniversalConvert.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.Settings}" Height="540" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="360" MinWidth="480"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="#E5E5E5" BorderThickness="1" Padding="8">
            <TabControl x:Name="SettingsTabs"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static loc:Strings.Cancel}" Padding="16,6" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.Save}" Padding="16,6" FontWeight="SemiBold" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>

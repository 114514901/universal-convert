<Window x:Class="UniversalConvert.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UniversalConvert.App.Localization"
        Title="{x:Static loc:Strings.Settings}" Height="540" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="360" MinWidth="460">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Cancel}" Padding="16,6" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.Save}" Padding="16,6" FontWeight="SemiBold" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
